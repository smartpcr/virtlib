{
  "ApplicationMetadata": {
    "ApplicationName": "virtlib",
    "EnvironmentName": "Development",
    "BuildVersion": "0.2.1",
    "DeploymentRing": "ring-0"
  },
  "MonitorSettings": {
    "Logs": {
      "SinkTypes": "Console, File, OTLP"
    },
    "Traces": {
      "SinkTypes": "Console, File, OTLP",
      "SamplerTypes": "RatioBased",
      "SamplerRatio": "0.25"
    },
    "Metrics": {
      "SinkTypes": "Console, File, OTLP"
    },
    "Sinks": {
      "File": {
        "Log": {
          "FilePrefix": "log"
        },
        "Trace": {
          "FilePrefix": "trace"
        },
        "Metrics": {
          "FilePrefix": "metrics"
        }
      },
      "Otlp": {
        "Endpoint": "http://localhost:4317"
      }
    }
  }
}